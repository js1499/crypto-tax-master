    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "shadcn": "^4.21.0",
